            ],
            "url": {
              "raw": "{{base_url}}/students/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "students",
                ""
              ]
            },
            "description": "Expect 400 naming email.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roll_number\": \"21CSE099\",\n  \"full_name\": \"Anitha Ramesh\",\n  \"email\": \"not-an-email\",\n  \"phone\": \"9876543210\",\n  \"department\": \"CSE\",\n  \"year_of_study\": 3,\n  \"cgpa\": \"8.75\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Create with duplicate roll number",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/students/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "students",
                ""
              ]
            },
            "description": "Run after Create student. Expect 400 naming roll_number.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roll_number\": \"21CSE045\",\n  \"full_name\": \"Anitha Ramesh\",\n  \"email\": \"someone.else@example.edu\",\n  \"phone\": \"9876543210\",\n  \"department\": \"CSE\",\n  \"year_of_study\": 3,\n  \"cgpa\": \"8.75\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Create with CGPA above 10",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/students/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "students",
                ""
              ]
            },
            "description": "Expect 400 naming cgpa.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roll_number\": \"21CSE100\",\n  \"full_name\": \"Anitha Ramesh\",\n  \"email\": \"high.cgpa@example.edu\",\n  \"phone\": \"9876543210\",\n  \"department\": \"CSE\",\n  \"year_of_study\": 3,\n  \"cgpa\": \"12.50\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Create with year out of range",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/students/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "students",
                ""
              ]
            },
            "description": "Expect 400 naming year_of_study.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roll_number\": \"21CSE101\",\n  \"full_name\": \"Anitha Ramesh\",\n  \"email\": \"bad.year@example.edu\",\n  \"phone\": \"9876543210\",\n  \"department\": \"CSE\",\n  \"year_of_study\": 7,\n  \"cgpa\": \"8.75\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Read non-existent ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/students/9999/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "students",
                "9999",
                ""
              ]
            },
            "description": "Expect 404."
          },
          "response": []
        },
        {
          "name": "Update non-existent ID",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/students/9999/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "students",
                "9999",
                ""
              ]
            },
            "description": "Expect 404.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roll_number\": \"21CSE045\",\n  \"full_name\": \"Anitha Ramesh\",\n  \"email\": \"anitha.r@example.edu\",\n  \"phone\": \"9876543210\",\n  \"department\": \"CSE\",\n  \"year_of_study\": 3,\n  \"cgpa\": \"8.75\"\n}"
            }
          },
          "response": []
        },
        {
          "name": "Delete non-existent ID",
          "request": {
            "method": "DELETE",
